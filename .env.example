# Create a local .env file in the app you run. Never commit the real value.
TYPESAFE_API_KEY=

# Pin the evaluated model so thresholds do not silently change.
TYPESAFE_MODEL=jev-1.13.0

# Shared Hono API. These values are not secrets.
HOST=127.0.0.1
PORT=8787
JEV_ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost:3009,http://localhost:3010
JEV_EVALUATION_RATE_LIMIT=20
JEV_COMPOSE_RATE_LIMIT=5
# Set only when the API is behind a trusted proxy that replaces X-Forwarded-For.
JEV_TRUST_PROXY=false

# Optional frontend overrides. API URLs are public configuration, never keys.
VITE_JEV_API_URL=http://localhost:8787
PUBLIC_JEV_API_URL=http://localhost:8787
